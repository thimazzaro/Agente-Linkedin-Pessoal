# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Agent — Environment Variables
# Copy to .env for local development. In Railway, set these as env vars in the dashboard.
# NEVER commit .env to git. NEVER put real values in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Tavily (web search) ───────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── Google AI (Gemini Imagen — image generation) ──────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
# Leave empty to run without images (agent continues normally).
GOOGLE_AI_API_KEY=

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Step 1: Get Client ID and Secret from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# Step 2: Run scripts/setup_linkedin_auth.py once — it fills the two values below
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Optional: verified sender address (defaults to onboarding@resend.dev for testing)
# EMAIL_FROM=LinkedIn Agent <noreply@yourdomain.com>

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.railway.app
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRIGGER_SECRET=
PUBLISH_TIME_DISPLAY=09:00 BRT

# Optional overrides
# CONFIG_PATH=config.yaml
# DATABASE_URL=sqlite:///./data/agent.db
