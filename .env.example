# ─────────────────────────────────────────────────────────────────────────────
# LinkedIn Agent — Environment Variables
# Copy to .env for local development. In Railway, set these as env vars in the dashboard.
# NEVER commit .env to git. NEVER put real values in this file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Tavily (web search) ───────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# Step 1: Get Client ID and Secret from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# Step 2: Run scripts/setup_linkedin_auth.py once — it fills the two values below
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
SMTP_USER=your@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SMTP_SENDER_NAME=LinkedIn Agent

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://your-app.railway.app
TRIGGER_SECRET=generate-with-python-secrets-token-urlsafe-32
PUBLISH_TIME_DISPLAY=09:00 BRT

# Optional overrides
# CONFIG_PATH=config.yaml
# DATABASE_URL=sqlite:///./data/agent.db
